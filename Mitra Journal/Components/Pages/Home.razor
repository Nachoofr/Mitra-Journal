@page "/"
@using Mitra_Journal.Components.Layout
@using Mitra_Journal.Entities
@using Mitra_Journal.Services
@using Mitra_Journal.Services.Interface

@layout MainLayout

@inject NavigationManager Navigation
@inject IJournalService JournalService
@inject ThemeService ThemeService

<div class="d-flex vh-100 @(currentModeClass)">
    <div class="flex-fill p-4 overflow-auto @(isDarkMode ? "dark-mode" : "light-mode")">
        <div class="container-fluid">

            <!-- Header -->
            <div class="mb-4">
                <h2 class="fw-bold @(isDarkMode ? "text-light" : "")">All Entries</h2>
                <small class="text-muted">
                    Total Entries: @filteredJournals.Count
                </small>
            </div>

            <!-- Filters -->
            <div class="card shadow-sm mb-4 @(isDarkMode ? "bg-dark border-secondary" : "")">
                <div class="card-body p-4">

                    <h6 class="fw-semibold mb-3 @(isDarkMode ? "text-light" : "")">
                        <i class="bi bi-funnel me-2"></i> Search & Filter
                    </h6>

                    <!-- Search -->
                    <input class="form-control mb-3 @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                           placeholder="Search title or content..."
                           @oninput="OnSearchChanged" />

                    <div class="row g-3">

                        <!-- Mood -->
                        <div class="col-md-4">
                            <label class="form-label small">Mood</label>
                            <select class="form-select @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                                    @onchange="OnMoodChanged">
                                <option value="">All</option>
                                @foreach (var mood in moods)
                                {
                                    <option value="@mood.MoodId">@mood.MoodName</option>
                                }
                            </select>
                        </div>

                        <!-- Tag -->
                        <div class="col-md-4">
                            <label class="form-label small">Tag</label>
                            <select class="form-select @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                                    @onchange="OnTagChanged">
                                <option value="">All</option>
                                @foreach (var tag in tags)
                                {
                                    <option value="@tag.TagId">@tag.TagName</option>
                                }
                            </select>
                        </div>

                        <!-- Date -->
                        <div class="col-md-4">
                            <label class="form-label small">Date</label>
                            <input type="date"
                                   class="form-control @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                                   @onchange="OnDateChanged" />
                        </div>

                    </div>
                </div>
            </div>

            <!-- Journal Cards -->
            @if (filteredJournals.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x text-muted" style="font-size: 4rem;"></i>
                    <h5 class="mt-3">No entries found</h5>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var journal in filteredJournals)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm @(isDarkMode ? "bg-dark border-secondary text-light" : "")">
                                <div class="card-body d-flex flex-column">

                                    <h5>@journal.Title</h5>

                                    <small class="text-muted">
                                        @journal.CreatedAt.ToString("dd MMM yyyy")
                                    </small>

                                    <p class="flex-grow-1 @(isDarkMode ? "text-secondary" : "text-muted")">
                                        @((MarkupString)(
                                            journal.Description.Length > 120
                                                ? journal.Description[..120] + "..."
                                                : journal.Description))
                                    </p>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="badge bg-primary">
                                            @journal.Mood.MoodName
                                        </span>

                                        <span class="badge bg-secondary">
                                            @journal.Tags.TagName
                                        </span>

                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenEntry(journal.JournalId)">
                                            View
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

@code {

    /* ================= THEME ================= */
    private bool isDarkMode => ThemeService.IsDarkMode;
    private string currentModeClass => isDarkMode ? "dark-mode" : "light-mode";

    /* ================= DATA ================= */
    private List<Journal> journals = new();
    private List<Journal> filteredJournals = new();

    /* ================= FILTER STATE ================= */
    private string searchText = "";
    private Guid? selectedMood = null;
    private Guid? selectedTag = null;
    private DateTime? selectedDate = null;

    /* ================= DROPDOWN DATA ================= */
    private List<Mood> moods = new();
    private List<Tags> tags = new();

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;

        journals = await JournalService.GetAllJournalsAsync();

        moods = journals.Select(j => j.Mood).Distinct().ToList();
        tags = journals.Select(j => j.Tags).Distinct().ToList();

        ApplyFilters();
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    /* ================= FILTER LOGIC ================= */
    private void ApplyFilters()
    {
        filteredJournals = journals
            .Where(j =>
                // Search: Title OR Description
                (string.IsNullOrWhiteSpace(searchText) ||
                 j.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) )

                // Mood
                && (!selectedMood.HasValue || j.Mood.MoodId == selectedMood.Value)

                // Tag
                && (!selectedTag.HasValue || j.Tags.TagId == selectedTag.Value)

                // Date
                && (!selectedDate.HasValue || j.CreatedAt.Date == selectedDate.Value.Date)
            )
            .OrderBy(j => j.CreatedAt)
            .ToList();
    }

    /* ================= EVENT HANDLERS ================= */
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnMoodChanged(ChangeEventArgs e)
    {
        selectedMood = Guid.TryParse(e.Value?.ToString(), out var id)
            ? id
            : null;

        ApplyFilters();
    }

    private void OnTagChanged(ChangeEventArgs e)
    {
        selectedTag = Guid.TryParse(e.Value?.ToString(), out var id)
            ? id
            : null;

        ApplyFilters();
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        selectedDate = DateTime.TryParse(e.Value?.ToString(), out var date)
            ? date
            : null;

        ApplyFilters();
    }

    private void OpenEntry(Guid id)
    {
        Navigation.NavigateTo($"/journal/{id}");
    }
}
