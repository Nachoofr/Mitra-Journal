@page "/export"
@using Mitra_Journal.Services
@inject IJournalPdfService PdfExportService
@inject ThemeService ThemeService
@inject IJSRuntime JS
@implements IDisposable

<div class="min-h-screen @(isDarkMode ? "bg-gray-900" : "bg-gray-50") p-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-8">
            <div class="w-12 h-12 bg-blue-600 rounded-2xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800")">Export Journal</h1>
                <p class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-500") mt-1">Export your entries as a PDF document</p>
            </div>
        </div>

        <!-- Export Card -->
        <div class="@(isDarkMode ? "bg-gray-800" : "bg-white") rounded-2xl p-8 shadow-sm">
            <h3 class="text-xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800") mb-6">
                <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Select Date Range
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">From Date</label>
                    <input type="date" 
                           @bind="fromDate"
                           class="flex-fill px-4 py-2.5 rounded-lg border @(isDarkMode ? "bg-gray-700 border-gray-600 text-gray-100" : "bg-white border-gray-300 text-gray-900") focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                </div>

                <div>
                    <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">To Date</label>
                    <input type="date" 
                           @bind="toDate"
                           class="flex-fill px-4 py-2.5 rounded-lg border @(isDarkMode ? "bg-gray-700 border-gray-600 text-gray-100" : "bg-white border-gray-300 text-gray-900") focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                </div>
            </div>

            <div class="@(isDarkMode ? "bg-blue-900/20 border-blue-800" : "bg-blue-50 border-blue-200") border rounded-lg p-4 mb-6">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 @(isDarkMode ? "text-blue-400" : "text-blue-600") mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="text-sm @(isDarkMode ? "text-blue-300" : "text-blue-800")">
                        The PDF will include all journal entries between the selected dates with their moods and tags.
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-between">
                <div class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-600")">
                    <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Selected range: <span class="font-semibold">@((toDate - fromDate).Days + 1) days</span>
                </div>
                
                <button @onclick="ExportPdf"
                        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-all shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@isExporting">
                    @if (isExporting)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Generating PDF...</span>
                    }
                    else
                    {
                        <svg class="w-5 h-5 inline-block mr-2 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <span>Export PDF</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private DateTime fromDate = DateTime.Today.AddDays(-7);
    private DateTime toDate = DateTime.Today;
    private bool isExporting = false;
    
    private bool isDarkMode => ThemeService.IsDarkMode;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private async Task ExportPdf()
    {
        isExporting = true;
        StateHasChanged();

        try
        {
            var pdfBytes = await PdfExportService.ExportJournalToPdfAsync(fromDate, toDate);

            // Save the PDF to local filesystem (MAUI)
            var filePath = Path.Combine(FileSystem.Current.CacheDirectory, "JournalExport.pdf");
            await File.WriteAllBytesAsync(filePath, pdfBytes);

            // Open PDF in default viewer
            await Launcher.OpenAsync(new OpenFileRequest
            {
                File = new ReadOnlyFile(filePath)
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting PDF: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}