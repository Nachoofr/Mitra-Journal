@page "/export"
@using Mitra_Journal.Services
@inject IJournalPdfService PdfExportService
@inject ThemeService ThemeService
@inject IJSRuntime JS

<div class="min-h-screen @(isDarkMode ? "bg-gray-900" : "bg-gray-50") p-6">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-bold @(isDarkMode ? "text-gray-100" : "text-gray-800")">Export Journal</h1>
                <p class="@(isDarkMode ? "text-gray-400" : "text-gray-500") text-sm">Export your entries as a PDF</p>
            </div>
        </div>
    </div>

    <!-- Export Card -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="@(isDarkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200") rounded-2xl p-6 border shadow-md col-span-1 md:col-span-3">
            <h3 class="font-semibold @(isDarkMode ? "text-gray-200" : "text-gray-700") mb-6 text-xl">Select Date Range</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div class="flex flex-col">
                    <label class="text-gray-700 dark:text-gray-300 mb-1 font-medium">From</label>
                    <input type="date" @bind="fromDate"
                           class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-400 dark:bg-gray-700 dark:text-gray-100 transition" />
                </div>

                <div class="flex flex-col">
                    <label class="text-gray-700 dark:text-gray-300 mb-1 font-medium">To</label>
                    <input type="date" @bind="toDate"
                           class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-400 dark:bg-gray-700 dark:text-gray-100 transition" />
                </div>
            </div>

            <button @onclick="ExportPdf"
                    class="w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-all shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                Export PDF
            </button>
        </div>
    </div>
</div>

@code {
    private DateTime fromDate = DateTime.Today.AddDays(-7);
    private DateTime toDate = DateTime.Today;
    private bool isDarkMode => ThemeService.IsDarkMode;

    private async Task ExportPdf()
    {
        var pdfBytes = await PdfExportService.ExportJournalToPdfAsync(fromDate, toDate);

        // Save the PDF to local filesystem (MAUI)
        var filePath = Path.Combine(FileSystem.Current.CacheDirectory, "JournalExport.pdf");
        await File.WriteAllBytesAsync(filePath, pdfBytes);

        // Open PDF in default viewer
        await Launcher.OpenAsync(new OpenFileRequest
        {
            File = new ReadOnlyFile(filePath)
        });
    }
}