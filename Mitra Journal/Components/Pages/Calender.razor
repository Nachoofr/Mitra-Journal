@page "/calendar"
@using Mitra_Journal.Services
@using Mitra_Journal.Services.Interface
@using Mitra_Journal.Entities
@inject IJournalService JournalService
@inject NavigationManager Navigation
@inject ThemeService ThemeService
@implements IDisposable

<div class="min-h-screen @(isDarkMode ? "bg-gray-900" : "bg-gray-50") p-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-8">
            <div class="w-12 h-12 bg-purple-600 rounded-2xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h1 class="text-3xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800")">Calendar</h1>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 gap-6 mb-8">
            <div class="@(isDarkMode ? "bg-gray-800" : "bg-white") rounded-2xl p-6 shadow-sm">
                <div class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-500") mb-2">This Month</div>
                <div class="text-3xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800")">
                    @entriesThisMonth <span class="text-lg @(isDarkMode ? "text-gray-500" : "text-gray-400")">/ @daysInCurrentMonth</span>
                </div>
            </div>
            <div class="@(isDarkMode ? "bg-gray-800" : "bg-white") rounded-2xl p-6 shadow-sm">
                <div class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-500") mb-2">Total Entries</div>
                <div class="text-3xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800")">@totalEntries</div>
            </div>
        </div>

        <!-- Calendar Card -->
        <div class="@(isDarkMode ? "bg-gray-800" : "bg-white") rounded-2xl p-8 shadow-sm">
            <!-- Calendar Header -->
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-2xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800")">@currentDate.ToString("MMMM")</h2>
                    <div class="text-2xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800")">@currentDate.Year</div>
                </div>
                <div class="flex items-center gap-3">
                    <button @onclick="GoToToday" class="px-4 py-2 text-sm @(isDarkMode ? "text-gray-300 hover:text-gray-100 hover:bg-gray-700" : "text-gray-600 hover:text-gray-800 hover:bg-gray-100") rounded-lg transition">
                        Today
                    </button>
                    <button @onclick="PreviousMonth" class="p-2 @(isDarkMode ? "hover:bg-gray-700" : "hover:bg-gray-100") rounded-lg transition">
                        <svg class="w-5 h-5 @(isDarkMode ? "text-gray-300" : "text-gray-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <button @onclick="NextMonth" class="p-2 @(isDarkMode ? "hover:bg-gray-700" : "hover:bg-gray-100") rounded-lg transition">
                        <svg class="w-5 h-5 @(isDarkMode ? "text-gray-300" : "text-gray-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Day Headers -->
            <div class="grid grid-cols-7 gap-4 mb-4">
                @foreach (var day in dayNames)
                {
                    <div class="text-center text-xs font-medium @(isDarkMode ? "text-gray-500" : "text-gray-400") py-2">@day</div>
                }
            </div>

            <!-- Calendar Grid -->
            <div class="grid grid-cols-7 gap-4">
                @foreach (var day in calendarDays)
                {
                    <div @onclick="() => OnDayClick(day)" 
                         class="@GetDayClass(day) aspect-square flex flex-col items-center justify-center p-2 rounded-lg cursor-pointer transition relative">
                        <span class="text-sm">@day.Day</span>
                        @if (day.HasEntry)
                        {
                            <div class="absolute bottom-1 flex gap-0.5">
                                <div class="w-1.5 h-1.5 rounded-full @GetMoodColor(day.MoodName)"></div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Legend -->
            <div class="flex items-center gap-6 mt-8 pt-6 border-t @(isDarkMode ? "border-gray-700" : "border-gray-100")">
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                    <span class="text-sm @(isDarkMode ? "text-gray-300" : "text-gray-600")">Positive</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                    <span class="text-sm @(isDarkMode ? "text-gray-300" : "text-gray-600")">Neutral</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                    <span class="text-sm @(isDarkMode ? "text-gray-300" : "text-gray-600")">Negative</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
@if (showModal && selectedDayJournals.Any())
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @onclick="CloseModal">
        <div class="@(isDarkMode ? "bg-gray-800" : "bg-white") rounded-2xl max-w-2xl w-full max-h-[80vh] overflow-hidden" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="flex items-center justify-between p-6 border-b @(isDarkMode ? "border-gray-700" : "border-gray-100")">
                <div>
                    <h3 class="text-xl font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800")">
                        @selectedDate.ToString("MMMM dd, yyyy")
                    </h3>
                    <p class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-500") mt-1">@selectedDayJournals.Count @(selectedDayJournals.Count == 1 ? "entry" : "entries")</p>
                </div>
                <button @onclick="CloseModal" class="p-2 @(isDarkMode ? "hover:bg-gray-700" : "hover:bg-gray-100") rounded-lg transition">
                    <svg class="w-5 h-5 @(isDarkMode ? "text-gray-300" : "text-gray-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="p-6 overflow-y-auto max-h-[calc(80vh-140px)]">
                @foreach (var journal in selectedDayJournals)
                {
                    <div class="mb-4 p-4 border @(isDarkMode ? "border-gray-700 hover:border-purple-500" : "border-gray-200 hover:border-purple-300") rounded-xl transition">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex-1">
                                <h4 class="font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-800") mb-1">@journal.Title</h4>
                                <p class="text-sm @(isDarkMode ? "text-gray-300" : "text-gray-600") line-clamp-2">@journal.Description</p>
                            </div>
                            @if (journal.Mood != null)
                            {
                                <div class="ml-4 px-3 py-1 rounded-full text-xs font-medium @GetMoodBadgeClass(journal.Mood.MoodName)">
                                    @journal.Mood.MoodName
                                </div>
                            }
                        </div>

                        @if (journal.JournalTags?.Any() == true)
                        {
                            <div class="flex flex-wrap gap-2 mb-3">
                                @foreach (var jt in journal.JournalTags.Take(3))
                                {
                                    <span class="px-2 py-1 @(isDarkMode ? "bg-gray-700 text-gray-300" : "bg-gray-100 text-gray-600") text-xs rounded-md">
                                        @jt.Tag?.TagName
                                    </span>
                                }
                                @if (journal.JournalTags.Count > 3)
                                {
                                    <span class="px-2 py-1 @(isDarkMode ? "bg-gray-700 text-gray-300" : "bg-gray-100 text-gray-600") text-xs rounded-md">
                                        +@(journal.JournalTags.Count - 3) more
                                    </span>
                                }
                            </div>
                        }

                        <div class="flex items-center justify-between">
                            <span class="text-xs @(isDarkMode ? "text-gray-500" : "text-gray-400")">
                                @journal.CreatedAt.ToString("h:mm tt")
                            </span>
                            <button @onclick="() => ViewJournal(journal.JournalId)" 
                                    class="px-6 py-2 bg-purple-600 text-white text-sm font-semibold rounded-lg hover:bg-purple-700 transition">
                                View Journal
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private DateTime currentDate = DateTime.Today;
    private int entriesThisMonth = 0;
    private int totalEntries = 0;
    private int daysInCurrentMonth => DateTime.DaysInMonth(currentDate.Year, currentDate.Month);
    
    private string[] dayNames = { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" };
    
    private List<CalendarDay> calendarDays = new();
    private Dictionary<DateTime, List<Journal>> journalsByDate = new();
    
    private bool showModal = false;
    private DateTime selectedDate;
    private List<Journal> selectedDayJournals = new();

    private bool isDarkMode => ThemeService.IsDarkMode;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        await LoadDataAsync();
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private async Task LoadDataAsync()
    {
        var startDate = new DateTime(currentDate.Year, currentDate.Month, 1).AddMonths(-1);
        var endDate = new DateTime(currentDate.Year, currentDate.Month, 1).AddMonths(2);

        var allJournals = await GetJournalsForDateRangeAsync(startDate, endDate);
        
        journalsByDate = allJournals
            .GroupBy(j => j.CreatedAt.Date)
            .ToDictionary(g => g.Key, g => g.ToList());

        var streakResult = await JournalService.GetStreaksAsync();
        totalEntries = streakResult.TotalJournals;
        
        entriesThisMonth = allJournals
            .Count(j => j.CreatedAt.Year == currentDate.Year && j.CreatedAt.Month == currentDate.Month);

        GenerateCalendarDays();
    }

    private async Task<List<Journal>> GetJournalsForDateRangeAsync(DateTime start, DateTime end)
    {
        var (_, journals) = await JournalService.GetAllJournalsAsync(1, int.MaxValue);
        return journals.Where(j => j.CreatedAt.Date >= start.Date && j.CreatedAt.Date < end.Date).ToList();
    }

    private void GenerateCalendarDays()
    {
        calendarDays.Clear();
        
        var firstDayOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);
        var lastDayOfMonth = new DateTime(currentDate.Year, currentDate.Month, daysInCurrentMonth);
        var startingDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
        
        var prevMonth = currentDate.AddMonths(-1);
        var daysInPrevMonth = DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        
        for (int i = startingDayOfWeek - 1; i >= 0; i--)
        {
            var date = new DateTime(prevMonth.Year, prevMonth.Month, daysInPrevMonth - i);
            calendarDays.Add(CreateCalendarDay(date, false));
        }
        
        var today = DateTime.Today;
        for (int i = 1; i <= daysInCurrentMonth; i++)
        {
            var date = new DateTime(currentDate.Year, currentDate.Month, i);
            calendarDays.Add(CreateCalendarDay(date, true, date == today));
        }
        
        var remainingDays = 42 - calendarDays.Count;
        var nextMonth = currentDate.AddMonths(1);
        for (int i = 1; i <= remainingDays; i++)
        {
            var date = new DateTime(nextMonth.Year, nextMonth.Month, i);
            calendarDays.Add(CreateCalendarDay(date, false));
        }
    }

    private CalendarDay CreateCalendarDay(DateTime date, bool isCurrentMonth, bool isToday = false)
    {
        var hasEntry = journalsByDate.ContainsKey(date);
        string? moodName = null;
        
        if (hasEntry && journalsByDate[date].Any())
        {
            moodName = journalsByDate[date]
                .OrderByDescending(j => j.CreatedAt)
                .FirstOrDefault()?.Mood?.MoodName;
        }

        return new CalendarDay
        {
            Day = date.Day,
            IsCurrentMonth = isCurrentMonth,
            IsToday = isToday,
            Date = date,
            HasEntry = hasEntry,
            MoodName = moodName
        };
    }

    private string GetDayClass(CalendarDay day)
    {
        var classes = new List<string>();
        
        if (!day.IsCurrentMonth)
        {
            classes.Add(isDarkMode ? "text-gray-600" : "text-gray-300");
        }
        else
        {
            classes.Add(isDarkMode ? "text-gray-200 font-medium" : "text-gray-700 font-medium");
        }
        
        if (day.IsToday)
        {
            classes.Add(isDarkMode ? "bg-gray-700" : "bg-gray-200");
        }

        if (day.HasEntry)
        {
            classes.Add(isDarkMode ? "hover:bg-purple-900/30" : "hover:bg-purple-50");
        }
        else
        {
            classes.Add(isDarkMode ? "hover:bg-gray-700" : "hover:bg-gray-50");
        }
        
        return string.Join(" ", classes);
    }

    private string GetMoodColor(string? moodName)
    {
        return moodName?.ToLower() switch
        {
            "positive" or "happy" or "great" => "bg-green-500",
            "neutral" or "okay" or "normal" => "bg-blue-500",
            "negative" or "sad" or "bad" => "bg-red-500",
            _ => "bg-gray-400"
        };
    }

    private string GetMoodBadgeClass(string? moodName)
    {
        return moodName?.ToLower() switch
        {
            "positive" or "happy" or "great" => "bg-green-100 text-green-700",
            "neutral" or "okay" or "normal" => "bg-blue-100 text-blue-700",
            "negative" or "sad" or "bad" => "bg-red-100 text-red-700",
            _ => "bg-gray-100 text-gray-700"
        };
    }

    private async Task PreviousMonth()
    {
        currentDate = currentDate.AddMonths(-1);
        await LoadDataAsync();
    }

    private async Task NextMonth()
    {
        currentDate = currentDate.AddMonths(1);
        await LoadDataAsync();
    }

    private async Task GoToToday()
    {
        currentDate = DateTime.Today;
        await LoadDataAsync();
    }

    private void OnDayClick(CalendarDay day)
    {
        if (day.HasEntry && journalsByDate.ContainsKey(day.Date))
        {
            selectedDate = day.Date;
            selectedDayJournals = journalsByDate[day.Date]
                .OrderByDescending(j => j.CreatedAt)
                .ToList();
            showModal = true;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        selectedDayJournals.Clear();
    }

    private void ViewJournal(Guid journalId)
    {
        Navigation.NavigateTo($"/home/{journalId}");
    }

    private class CalendarDay
    {
        public int Day { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool IsToday { get; set; }
        public DateTime Date { get; set; }
        public bool HasEntry { get; set; }
        public string? MoodName { get; set; }
    }
}