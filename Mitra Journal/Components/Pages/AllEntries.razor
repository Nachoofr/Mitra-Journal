@page "/all-entries"
@using Mitra_Journal.Components.Layout
@using Mitra_Journal.Entities
@using Mitra_Journal.Services
@using Mitra_Journal.Services.Interface

@layout MainLayout

@inject NavigationManager Navigation
@inject IJournalService JournalService
@inject ThemeService ThemeService
@inject IMoodService MoodService

<div class="@(isDarkMode ? "bg-gray-900 text-gray-100" : "bg-gray-50 text-gray-900") min-h-screen transition-colors duration-300">
    <div class="flex-fill mx-auto px-4 py-8 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold @(isDarkMode ? "text-white" : "text-gray-900") mb-2">All Entries</h1>
            <p class="@(isDarkMode ? "text-gray-400" : "text-gray-600") text-sm">
                Browse through all your journal entries
            </p>
            <p class="@(isDarkMode ? "text-gray-500" : "text-gray-500") text-xs mt-1">
                Total Entries: @totalCount | Page @currentPage of @totalPages
            </p>
        </div>

        <!-- Filter Box -->
        <div class="@(isDarkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200") rounded-xl border shadow-sm mb-6 overflow-hidden">
            <div class="p-6">
                <!-- Filter Header -->
                <div class="flex items-center mb-4">
                    <svg class="w-5 h-5 mr-2 @(isDarkMode ? "text-gray-400" : "text-gray-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                    </svg>
                    <h3 class="text-lg font-semibold @(isDarkMode ? "text-white" : "text-gray-900")">Search & Filter</h3>
                </div>

                <!-- Search Input -->
                <div class="mb-4">
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 @(isDarkMode ? "text-gray-500" : "text-gray-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input 
                            type="text" 
                            class="w-full pl-10 pr-4 py-3 @(isDarkMode ? "bg-gray-700 border-gray-600 text-white placeholder-gray-400" : "bg-gray-50 border-gray-300 text-gray-900 placeholder-gray-500") border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                            placeholder="Search title or content..."
                            @oninput="OnSearchChanged" />
                    </div>
                </div>

                <!-- Filter Options -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Mood Filter -->
                    <div>
                        <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">Mood</label>
                        <select 
                            class="w-full px-4 py-3 @(isDarkMode ? "bg-gray-700 border-gray-600 text-white" : "bg-gray-50 border-gray-300 text-gray-900") border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                            @onchange="OnMoodChanged">
                            <option value="">All</option>
                            @foreach (var mood in moods)
                            {
                                <option value="@mood.MoodId">@mood.MoodName</option>
                            }
                        </select>
                    </div>

                    <!-- Tag Filter -->
                    <div>
                        <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">Tag</label>
                        <select 
                            class="w-full px-4 py-3 @(isDarkMode ? "bg-gray-700 border-gray-600 text-white" : "bg-gray-50 border-gray-300 text-gray-900") border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                            @onchange="OnTagChanged">
                            <option value="">All</option>
                            @foreach (var tag in tags)
                            {
                                <option value="@tag.TagId">@tag.TagName</option>
                            }
                        </select>
                    </div>

                    <!-- Date Filter -->
                    <div>
                        <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">Date</label>
                        <div class="relative">
                            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 @(isDarkMode ? "text-gray-500" : "text-gray-400") pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <input 
                                type="date"
                                class="w-full pl-10 pr-4 py-3 @(isDarkMode ? "bg-gray-700 border-gray-600 text-white" : "bg-gray-50 border-gray-300 text-gray-900") border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                                @onchange="OnDateChanged" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Journal Cards -->
        @if (isLoading)
        {
            <div class="flex justify-center items-center py-20">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500"></div>
            </div>
        }
        else if (filteredJournals.Count == 0)
        {
            <div class="text-center py-20">
                <svg class="w-16 h-16 mx-auto @(isDarkMode ? "text-gray-600" : "text-gray-400") mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="text-xl font-semibold @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">No entries found</h3>
                <p class="@(isDarkMode ? "text-gray-500" : "text-gray-500") text-sm">Try adjusting your filters</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var journal in filteredJournals)
                {
                    <div class="@(isDarkMode ? "bg-gray-800 border-gray-700 hover:bg-gray-750" : "bg-white border-gray-200 hover:shadow-md") rounded-xl border transition-all duration-200 overflow-hidden group relative">
                        
                        <!-- Delete Button -->
                        <button @onclick="() => ShowDeleteConfirmation(journal.JournalId, journal.Title)"
                                @onclick:stopPropagation="true"
                                class="absolute top-4 right-4 z-10 p-2 rounded-lg @(isDarkMode ? "hover:bg-red-900/20 text-red-400 hover:text-red-300" : "hover:bg-red-50 text-red-600 hover:text-red-700") transition-colors duration-200"
                                title="Delete entry">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>

                        <!-- Clickable Card Content -->
                        <div class="p-6 cursor-pointer" @onclick="() => OpenEntry(journal.JournalId)">
                            <!-- Date and Time Header -->
                            <div class="flex items-center justify-between mb-4 pr-10">
                                <div class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                    <span class="text-sm font-semibold @(isDarkMode ? "text-gray-200" : "text-gray-900")">
                                        @journal.CreatedAt.ToString("dddd, MMMM dd, yyyy")
                                    </span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 @(isDarkMode ? "text-gray-500" : "text-gray-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-500")">
                                        @journal.CreatedAt.ToString("hh:mm tt")
                                    </span>
                                </div>
                            </div>

                            <!-- Title -->
                            <h3 class="text-xl font-bold @(isDarkMode ? "text-white" : "text-gray-900") mb-3">
                                @journal.Title
                            </h3>

                            <!-- Description -->
                            <p class="@(isDarkMode ? "text-gray-400" : "text-gray-600") text-sm leading-relaxed mb-4">
                                @((MarkupString)(
                                    journal.Description.Length > 120
                                        ? journal.Description[..120] + "..."
                                        : journal.Description))
                            </p>

                            <!-- Moods and Tags Section -->
                            <div class="flex flex-wrap items-center gap-2">
                                <!-- Primary Mood -->
                                @if (journal.Mood != null)
                                {
                                    var moodColor = GetMoodColor(journal.Mood.MoodName);
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium @moodColor">
                                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                        @journal.Mood.MoodName
                                    </span>
                                }

                                <!-- Secondary Moods -->
                                @if (journal.SecondaryMoodId1 != null)
                                {
                                    var secondaryMood1 = GetMoodById(journal.SecondaryMoodId1.Value);
                                    if (secondaryMood1 != null)
                                    {
                                        var moodColor = GetMoodColor(secondaryMood1.MoodName);
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium @moodColor">
                                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                            </svg>
                                            @secondaryMood1.MoodName
                                        </span>
                                    }
                                }

                                @if (journal.SecondaryMoodId2 != null)
                                {
                                    var secondaryMood2 = GetMoodById(journal.SecondaryMoodId2.Value);
                                    if (secondaryMood2 != null)
                                    {
                                        var moodColor = GetMoodColor(secondaryMood2.MoodName);
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium @moodColor">
                                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                                            </svg>
                                            @secondaryMood2.MoodName
                                        </span>
                                    }
                                }

                                <!-- Tags -->
                                @foreach (var jt in journal.JournalTags)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium @(isDarkMode ? "bg-blue-900/30 text-blue-300 border border-blue-700/50" : "bg-blue-50 text-blue-700 border border-blue-200")">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                        </svg>
                                        @jt.Tag.TagName
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Pagination -->
        @if (totalPages > 1 && !isLoading)
        {
            <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
                
                <!-- Previous Button -->
                <button 
                    @onclick="PreviousPage"
                    disabled="@(currentPage == 1)"
                    class="@(currentPage == 1 ? "opacity-50 cursor-not-allowed" : "hover:bg-blue-600") inline-flex items-center gap-2 px-4 py-2 bg-blue-500 text-white rounded-lg font-medium transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                </button>

                <!-- Page Numbers -->
                <div class="flex items-center gap-2">
                    @foreach (var p in GetPageNumbers())
                    {
                        if (p == -1)
                        {
                            <span class="@(isDarkMode ? "text-gray-500" : "text-gray-400") px-2">...</span>
                        }
                        else
                        {
                            <button 
                                @onclick="() => GoToPage(p)"
                                class="@(p == currentPage 
                                    ? isDarkMode ? "bg-blue-600 text-white" : "bg-blue-500 text-white"
                                    : isDarkMode ? "bg-gray-800 text-gray-300 hover:bg-gray-700" : "bg-white text-gray-700 hover:bg-gray-100") 
                                    w-10 h-10 rounded-lg font-medium transition-all duration-200 border @(isDarkMode ? "border-gray-700" : "border-gray-200")">
                                @p
                            </button>
                        }
                    }
                </div>

                <!-- Next Button -->
                <button 
                    @onclick="NextPage"
                    disabled="@(currentPage == totalPages)"
                    class="@(currentPage == totalPages ? "opacity-50 cursor-not-allowed" : "hover:bg-blue-600") inline-flex items-center gap-2 px-4 py-2 bg-blue-500 text-white rounded-lg font-medium transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                    Next
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>

            <!-- Items Per Page -->
            <div class="mt-4 text-center">
                <div class="inline-flex items-center gap-3">
                    <span class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-600")">Show:</span>
                    <div class="inline-flex gap-2">
                        @foreach (var size in new[] { 10, 25, 50, 100 })
                        {
                            <button 
                                @onclick="() => ChangePageSize(size)"
                                class="@(pageSize == size 
                                    ? isDarkMode ? "bg-blue-600 text-white" : "bg-blue-500 text-white"
                                    : isDarkMode ? "bg-gray-800 text-gray-300 hover:bg-gray-700" : "bg-white text-gray-700 hover:bg-gray-100") 
                                    px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 border @(isDarkMode ? "border-gray-700" : "border-gray-200")">
                                @size
                            </button>
                        }
                    </div>
                    <span class="text-sm @(isDarkMode ? "text-gray-400" : "text-gray-600")">per page</span>
                </div>
            </div>
        }

    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-fadeIn">
        <div class="@(isDarkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200") rounded-2xl shadow-2xl max-w-md w-full border overflow-hidden transform transition-all duration-300 scale-100">
            
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b @(isDarkMode ? "border-gray-700" : "border-gray-200")">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold @(isDarkMode ? "text-white" : "text-gray-900")">Delete Journal Entry</h3>
                    </div>
                    <button 
                        @onclick="CancelDelete"
                        class="@(isDarkMode ? "text-gray-400 hover:text-gray-300" : "text-gray-500 hover:text-gray-700") transition-colors duration-200">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="px-6 py-5">
                <p class="@(isDarkMode ? "text-gray-300" : "text-gray-700") mb-4">
                    Are you sure you want to delete this journal entry?
                </p>
                <div class="@(isDarkMode ? "bg-gray-700 border-gray-600" : "bg-gray-50 border-gray-200") rounded-lg p-4 border">
                    <p class="font-semibold @(isDarkMode ? "text-white" : "text-gray-900")">@journalToDeleteTitle</p>
                </div>
                <div class="mt-4 flex items-start gap-2 text-red-600">
                    <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-sm">This action cannot be undone.</p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 @(isDarkMode ? "bg-gray-750 border-gray-700" : "bg-gray-50 border-gray-200") border-t flex items-center justify-end gap-3">
                <button 
                    @onclick="CancelDelete"
                    class="px-4 py-2 @(isDarkMode ? "bg-gray-700 text-gray-300 hover:bg-gray-600" : "bg-white text-gray-700 hover:bg-gray-50") rounded-lg font-medium transition-all duration-200 border @(isDarkMode ? "border-gray-600" : "border-gray-300")">
                    Cancel
                </button>
                <button 
                    @onclick="ConfirmDelete"
                    disabled="@isDeleting"
                    class="@(isDeleting ? "opacity-50 cursor-not-allowed" : "hover:bg-red-700") inline-flex items-center gap-2 px-4 py-2 bg-red-600 text-white rounded-lg font-medium transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (isDeleting)
                    {
                        <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.2s ease-out;
    }

    .bg-gray-750 {
        background-color: #2d3748;
    }

    /* Hide calendar icon in dark mode for better visibility */
    input[type="date"]::-webkit-calendar-picker-indicator {
        @(isDarkMode ? "filter: invert(1);" : "")
    }
</style>

@code {


    private bool isDarkMode => ThemeService.IsDarkMode;


    private List<Journal> journals = new();
    private List<Journal> filteredJournals = new();
    private List<Mood> allMoods = new();


    private int currentPage = 1;
    private int pageSize = 3;
    private int totalCount;
    private int totalPages;
    private bool isLoading;


    private string searchText = "";
    private Guid? selectedMood;
    private Guid? selectedTag;
    private DateTime? selectedDate;


    private List<Mood> moods = new();
    private List<Tags> tags = new();


    private bool showDeleteModal = false;
    private Guid journalToDeleteId;
    private string journalToDeleteTitle = "";
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        await LoadAllMoodsAsync();
        await LoadJournalsAsync();
        await LoadFilterOptionsAsync();
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private async Task LoadAllMoodsAsync()
    {
        allMoods = MoodService.GetAllMoods();
    }

    private Mood? GetMoodById(Guid moodId)
    {
        return allMoods.FirstOrDefault(m => m.MoodId == moodId);
    }

    private string GetMoodColor(string moodName)
    {
        // Positive moods - Green
        var positiveMoods = new[] { "happy", "joyful", "excited", "grateful", "peaceful", "content", "loved", "hopeful", "proud", "energetic" };
        // Negative moods - Red
        var negativeMoods = new[] { "sad", "angry", "anxious", "stressed", "frustrated", "lonely", "tired", "worried", "disappointed", "overwhelmed" };
        
        var mood = moodName.ToLower();
        
        if (positiveMoods.Any(p => mood.Contains(p)))
        {
            return isDarkMode 
                ? "bg-green-900/30 text-green-300 border border-green-700/50" 
                : "bg-green-100 text-green-700 border border-green-200";
        }
        else if (negativeMoods.Any(n => mood.Contains(n)))
        {
            return isDarkMode 
                ? "bg-red-900/30 text-red-300 border border-red-700/50" 
                : "bg-red-100 text-red-700 border border-red-200";
        }
        else
        {
            // Neutral moods - Blue
            return isDarkMode 
                ? "bg-blue-900/30 text-blue-300 border border-blue-700/50" 
                : "bg-blue-100 text-blue-700 border border-blue-200";
        }
    }

    private async Task LoadJournalsAsync()
    {
        isLoading = true;

        (totalCount, journals) =
            await JournalService.GetAllJournalsAsync(currentPage, pageSize);

        ApplyFilters();
        isLoading = false;
    }

    private async Task LoadFilterOptionsAsync()
    {
        var (_, all) = await JournalService.GetAllJournalsAsync(1, int.MaxValue);

        moods = all.Select(j => j.Mood).Distinct().ToList();

        tags = all
            .SelectMany(j => j.JournalTags)
            .Select(jt => jt.Tag)
            .Distinct()
            .ToList();
    }

    private void ApplyFilters()
    {
        filteredJournals = journals
            .Where(j =>
                (string.IsNullOrWhiteSpace(searchText)
                 || j.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                 || j.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                && (!selectedMood.HasValue || j.MoodId == selectedMood)
                && (!selectedTag.HasValue ||
                    j.JournalTags.Any(jt => jt.TagId == selectedTag))
                && (!selectedDate.HasValue || j.CreatedAt.Date == selectedDate))
            .ToList();

        totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadJournalsAsync();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
            await GoToPage(currentPage + 1);
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
            await GoToPage(currentPage - 1);
    }

    private async Task ChangePageSize(int size)
    {
        pageSize = size;
        currentPage = 1;
        await LoadJournalsAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        currentPage = 1;
        await LoadJournalsAsync();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) 
                pages.Add(i);
        }
        else
        {
            pages.Add(1);
            
            if (currentPage > 3)
                pages.Add(-1);
            
            int start = Math.Max(2, currentPage - 1);
            int end = Math.Min(totalPages - 1, currentPage + 1);
            
            for (int i = start; i <= end; i++)
                pages.Add(i);
            
            if (currentPage < totalPages - 2)
                pages.Add(-1);
            
            pages.Add(totalPages);
        }
        
        return pages;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnMoodChanged(ChangeEventArgs e)
    {
        selectedMood = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        ApplyFilters();
    }

    private void OnTagChanged(ChangeEventArgs e)
    {
        selectedTag = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        ApplyFilters();
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        selectedDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
        ApplyFilters();
    }

    private void OpenEntry(Guid id)
    {
        Navigation.NavigateTo($"/home/{id}");
    }
    
    private void ShowDeleteConfirmation(Guid journalId, string title)
    {
        journalToDeleteId = journalId;
        journalToDeleteTitle = title;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        journalToDeleteId = Guid.Empty;
        journalToDeleteTitle = "";
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;

        try
        {
            await JournalService.DeleteJournalAsync(journalToDeleteId);
            
            // Close modal
            showDeleteModal = false;
            journalToDeleteId = Guid.Empty;
            journalToDeleteTitle = "";
            
            // Reload journals
            await LoadJournalsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting journal: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }
}