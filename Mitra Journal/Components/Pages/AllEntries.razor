@page "/all-entries"
@using Mitra_Journal.Components.Layout
@using Mitra_Journal.Entities
@using Mitra_Journal.Services
@using Mitra_Journal.Services.Interface

@layout MainLayout

@inject NavigationManager Navigation
@inject IJournalService JournalService
@inject ThemeService ThemeService
@inject IMoodService MoodService

<div class="@currentModeClass">
    <div class="flex-1 p-4 overflow-hidden @(isDarkMode ? "dark-mode" : "light-mode")">
        <div class="flex-1 px-4">

            <!-- Header -->
            <div class="mb-4">
                <h2 class="fw-bold @(isDarkMode ? "text-light" : "")">All Entries</h2>
                <small class="text-muted">
                    Total Entries: @totalCount | Page @currentPage of @totalPages
                </small>
            </div>

            <!-- Filters -->
            <div class="card shadow-sm mb-4 @(isDarkMode ? "bg-dark border-secondary" : "")">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3 @(isDarkMode ? "text-light" : "")">
                        <i class="bi bi-funnel me-2"></i> Search & Filter
                    </h6>

                    <!-- Search -->
                    <input class="form-control mb-3 @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                           placeholder="Search title or content..."
                           @oninput="OnSearchChanged" />

                    <div class="row g-3">

                        <!-- Mood -->
                        <div class="col-md-4">
                            <label class="form-label small">Mood</label>
                            <select class="form-select @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                                    @onchange="OnMoodChanged">
                                <option value="">All</option>
                                @foreach (var mood in moods)
                                {
                                    <option value="@mood.MoodId">@mood.MoodName</option>
                                }
                            </select>
                        </div>

                        <!-- Tag -->
                        <div class="col-md-4">
                            <label class="form-label small">Tag</label>
                            <select class="form-select @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                                    @onchange="OnTagChanged">
                                <option value="">All</option>
                                @foreach (var tag in tags)
                                {
                                    <option value="@tag.TagId">@tag.TagName</option>
                                }
                            </select>
                        </div>

                        <!-- Date -->
                        <div class="col-md-4">
                            <label class="form-label small">Date</label>
                            <input type="date"
                                   class="form-control @(isDarkMode ? "bg-dark text-light border-secondary" : "")"
                                   @onchange="OnDateChanged" />
                        </div>

                    </div>
                </div>
            </div>

            <!-- Journal Cards -->
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            }
            else if (filteredJournals.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x text-muted" style="font-size:4rem;"></i>
                    <h5 class="mt-3">No entries found</h5>
                </div>
            }
            else
            {
                @foreach (var journal in filteredJournals)
                {
                    <div class="@(isDarkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200")
                               rounded-3 mb-4 border shadow-sm p-4 position-relative">

                        <!-- Delete Button -->
                        <button @onclick="() => ShowDeleteConfirmation(journal.JournalId, journal.Title)"
                                @onclick:stopPropagation="true"
                                class="position-absolute top-4 right-4 p-2 rounded-lg hover:bg-red-50 text-red-600 hover:text-red-700 transition-colors duration-200"
                                title="Delete entry">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>

                        <!-- Clickable Card Content -->
                        <div @onclick="() => OpenEntry(journal.JournalId)"
                             style="cursor: pointer;">

                            <!-- Date -->
                            <div class="d-flex justify-content-between mb-3 pe-5">
                                <span class="fw-medium">
                                    @journal.CreatedAt.ToString("dddd, MMMM dd, yyyy")
                                </span>
                                <span class="text-muted">
                                    @journal.CreatedAt.ToString("hh:mm tt")
                                </span>
                            </div>

                            <!-- Title -->
                            <h5 class="fw-semibold mb-2 @(isDarkMode ? "text-light" : "")">
                                @journal.Title
                            </h5>

                            <!-- Description -->
                            <p class="@(isDarkMode ? "text-secondary" : "text-muted") mb-3">
                                @((MarkupString)(
                                    journal.Description.Length > 120
                                        ? journal.Description[..120] + "..."
                                        : journal.Description))
                            </p>

                            <!-- Moods Section -->
                            <div class="mb-2">
                                <!-- Primary Mood -->
                                <span class="badge bg-primary me-2">
                                    <i class="bi bi-star-fill me-1"></i>
                                    @journal.Mood?.MoodName
                                </span>

                                <!-- Secondary Mood 1 -->
                                @if (journal.SecondaryMoodId1 != null)
                                {
                                    var secondaryMood1 = GetMoodById(journal.SecondaryMoodId1.Value);
                                    if (secondaryMood1 != null)
                                    {
                                        <span class="badge bg-success me-2">
                                            <i class="bi bi-plus-circle-fill me-1"></i>
                                            @secondaryMood1.MoodName
                                        </span>
                                    }
                                }

                                <!-- Secondary Mood 2 -->
                                @if (journal.SecondaryMoodId2 != null)
                                {
                                    var secondaryMood2 = GetMoodById(journal.SecondaryMoodId2.Value);
                                    if (secondaryMood2 != null)
                                    {
                                        <span class="badge bg-success me-2">
                                            <i class="bi bi-plus-circle-fill me-1"></i>
                                            @secondaryMood2.MoodName
                                        </span>
                                    }
                                }
                            </div>

                            <!-- Tags -->
                            <div>
                                @foreach (var jt in journal.JournalTags)
                                {
                                    <span class="badge bg-outline-primary border text-primary me-1">
                                        @jt.Tag.TagName
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- Pagination -->
            @if (totalPages > 1 && !isLoading)
            {
                <div class="d-flex justify-content-between align-items-center mt-4">

                    <button class="btn btn-outline-primary btn-sm"
                            @onclick="PreviousPage"
                            disabled="@(currentPage == 1)">
                        Previous
                    </button>

                    <div class="d-flex gap-2">
                        @foreach (var p in GetPageNumbers())
                        {
                            if (p == -1)
                            {
                                <span>...</span>
                            }
                            else
                            {
                                <button class="btn btn-sm @(p == currentPage ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => GoToPage(p)">
                                    @p
                                </button>
                            }
                        }
                    </div>

                    <button class="btn btn-outline-primary btn-sm"
                            @onclick="NextPage"
                            disabled="@(currentPage == totalPages)">
                        Next
                    </button>
                </div>

                <div class="text-center mt-3">
                    <select class="form-select form-select-sm w-auto d-inline"
                            @onchange="OnPageSizeChanged">
                        <option value="3">3</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                    </select>
                </div>
            }

        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content @(isDarkMode ? "bg-dark text-light" : "")">
                <div class="modal-header border-bottom @(isDarkMode ? "border-secondary" : "")">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                        Delete Journal Entry
                    </h5>
                    <button type="button" 
                            class="btn-close @(isDarkMode ? "btn-close-white" : "")" 
                            @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Are you sure you want to delete this journal entry?</p>
                    <div class="alert alert-light @(isDarkMode ? "bg-secondary border-secondary" : "")" role="alert">
                        <strong>@journalToDeleteTitle</strong>
                    </div>
                    <p class="text-danger mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer border-top @(isDarkMode ? "border-secondary" : "")">
                    <button type="button" 
                            class="btn btn-secondary" 
                            @onclick="CancelDelete">
                        Cancel
                    </button>
                    <button type="button" 
                            class="btn btn-danger" 
                            @onclick="ConfirmDelete"
                            disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash me-2"></i>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    /* ========== THEME ========== */
    private bool isDarkMode => ThemeService.IsDarkMode;
    private string currentModeClass => isDarkMode ? "dark-mode" : "light-mode";

    /* ========== DATA ========== */
    private List<Journal> journals = new();
    private List<Journal> filteredJournals = new();
    private List<Mood> allMoods = new();

    /* ========== PAGINATION ========== */
    private int currentPage = 1;
    private int pageSize = 3;
    private int totalCount;
    private int totalPages;
    private bool isLoading;

    /* ========== FILTER STATE ========== */
    private string searchText = "";
    private Guid? selectedMood;
    private Guid? selectedTag;
    private DateTime? selectedDate;

    /* ========== FILTER OPTIONS ========== */
    private List<Mood> moods = new();
    private List<Tags> tags = new();

    /* ========== DELETE MODAL ========== */
    private bool showDeleteModal = false;
    private Guid journalToDeleteId;
    private string journalToDeleteTitle = "";
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        await LoadAllMoodsAsync();
        await LoadJournalsAsync();
        await LoadFilterOptionsAsync();
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private async Task LoadAllMoodsAsync()
    {
        allMoods = MoodService.GetAllMoods();
    }

    private Mood? GetMoodById(Guid moodId)
    {
        return allMoods.FirstOrDefault(m => m.MoodId == moodId);
    }

    private async Task LoadJournalsAsync()
    {
        isLoading = true;

        (totalCount, journals) =
            await JournalService.GetAllJournalsAsync(currentPage, pageSize);

        ApplyFilters();
        isLoading = false;
    }

    private async Task LoadFilterOptionsAsync()
    {
        var (_, all) = await JournalService.GetAllJournalsAsync(1, int.MaxValue);

        moods = all.Select(j => j.Mood).Distinct().ToList();

        tags = all
            .SelectMany(j => j.JournalTags)
            .Select(jt => jt.Tag)
            .Distinct()
            .ToList();
    }

    private void ApplyFilters()
    {
        filteredJournals = journals
            .Where(j =>
                (string.IsNullOrWhiteSpace(searchText)
                 || j.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                 || j.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                && (!selectedMood.HasValue || j.MoodId == selectedMood)
                && (!selectedTag.HasValue ||
                    j.JournalTags.Any(jt => jt.TagId == selectedTag))
                && (!selectedDate.HasValue || j.CreatedAt.Date == selectedDate))
            .ToList();

        totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadJournalsAsync();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
            await GoToPage(currentPage + 1);
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
            await GoToPage(currentPage - 1);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        currentPage = 1;
        await LoadJournalsAsync();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        for (int i = 1; i <= totalPages; i++) pages.Add(i);
        return pages;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnMoodChanged(ChangeEventArgs e)
    {
        selectedMood = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        ApplyFilters();
    }

    private void OnTagChanged(ChangeEventArgs e)
    {
        selectedTag = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        ApplyFilters();
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        selectedDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
        ApplyFilters();
    }

    private void OpenEntry(Guid id)
    {
        Navigation.NavigateTo($"/home/{id}");
    }

    /* ========== DELETE FUNCTIONALITY ========== */
    private void ShowDeleteConfirmation(Guid journalId, string title)
    {
        journalToDeleteId = journalId;
        journalToDeleteTitle = title;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        journalToDeleteId = Guid.Empty;
        journalToDeleteTitle = "";
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;

        try
        {
            await JournalService.DeleteJournalAsync(journalToDeleteId);
            
            // Close modal
            showDeleteModal = false;
            journalToDeleteId = Guid.Empty;
            journalToDeleteTitle = "";
            
            // Reload journals
            await LoadJournalsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting journal: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }
}