@page "/home"
@using Microsoft.AspNetCore.Components.Web
@using Mitra_Journal.Components.Layout
@using Mitra_Journal.Entities
@using Mitra_Journal.Services
@using Mitra_Journal.Services.Interface
@inject IJournalService _journalService
@inject NavigationManager nav
@inject ThemeService ThemeService
@implements IDisposable
@layout MainLayout

<div class="d-flex vh-100 w-100 @(currentModeClass)">
    <!-- Main Content -->
    <div class="flex-fill p-4 overflow-auto @(ThemeService.IsDarkMode ? "dark-mode" : "light-mode")">
        <div class="container-fluid" >
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-journal-text text-white fs-3"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold mb-1 @(ThemeService.IsDarkMode ? "text-light" : "")">Daily Journal</h2>
                        <p class="mb-0 @(ThemeService.IsDarkMode ? "text-secondary" : "text-muted")">
                            Capture your thoughts, track your moods
                        </p>
                    </div>
                </div>
                <div class="card shadow-sm @(ThemeService.IsDarkMode ? "bg-dark border-secondary" : "")">
                    <div class="card-body p-3 d-flex align-items-center gap-2">
                        <i class="bi bi-fire text-warning fs-5"></i>
                        <div>
                            <div class="fw-bold @(ThemeService.IsDarkMode ? "text-light" : "")">Current Streak</div>
                            <div class="small @(ThemeService.IsDarkMode ? "text-secondary" : "text-muted")">
                                <span class="fw-bold @(ThemeService.IsDarkMode ? "text-light" : "")">0</span> days
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Journal Card -->
            <div class="card shadow-sm @(ThemeService.IsDarkMode ? "bg-dark border-secondary" : "")">
                <div class="card-body p-4">

                    <!-- Date & Time -->
                    <div class="d-flex align-items-center gap-2 text-muted mb-4">
                        <i class="bi bi-calendar3"></i>
                        <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Time (Optional)</label>
                        <input type="time" class="form-control @(ThemeService.IsDarkMode ? "bg-transparent text-light" : "")" />
                    </div>

                    <!-- Mood Selector -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold mb-3">
                            How are you feeling today? <span class="text-danger">*</span>
                        </label>

                        @* Positive Moods *@
                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                    <i class="bi bi-emoji-smile text-white" style="font-size: 14px;"></i>
                                </div>
                                <span class="small fw-medium">Positive</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mood in positiveMoods)
                                {
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill @(selectedMood == mood ? "active" : "")"
                                            @onclick="() => SelectMood(mood)">
                                        @mood
                                    </button>
                                }
                            </div>
                        </div>

                        @* Neutral Moods *@
                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-info d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                    <i class="bi bi-emoji-neutral text-white" style="font-size: 14px;"></i>
                                </div>
                                <span class="small fw-medium">Neutral</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mood in neutralMoods)
                                {
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill @(selectedMood == mood ? "active" : "")"
                                            @onclick="() => SelectMood(mood)">
                                        @mood
                                    </button>
                                }
                            </div>
                        </div>

                        @* Negative Moods *@
                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                    <i class="bi bi-emoji-frown text-white" style="font-size: 14px;"></i>
                                </div>
                                <span class="small fw-medium">Negative</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mood in negativeMoods)
                                {
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill @(selectedMood == mood ? "active" : "")"
                                            @onclick="() => SelectMood(mood)">
                                        @mood
                                    </button>
                                }
                            </div>
                        </div>

                        <small class="text-muted">
                            Click a mood to set as primary. Use the + button to add up to 2 secondary moods.
                        </small>
                    </div>

                    <!-- Title -->
                    <div class="mb-4">
                        <input type="text"
                               class="form-control form-control-lg border-0 px-0 @(ThemeService.IsDarkMode ? "bg-transparent text-light" : "")"
                               placeholder="Give your entry a title..."
                               @bind="entryTitle" />
                    </div>

                    <!-- Journal Entry -->
                    <div class="mb-4">
                        <textarea class="form-control @(ThemeService.IsDarkMode ? "bg-dark text-light border-secondary" : "")"
                                  rows="10"
                                  placeholder="Start writing..."
                                  @bind="entryContent"></textarea>
                        <small class="d-block mt-2 @(ThemeService.IsDarkMode ? "text-secondary" : "text-muted")">
                            Markdown supported: # Headers, **bold**, *italic*, [link](url), * lists
                        </small>
                    </div>

                    <!-- Tags -->
                    <div class="mb-4">
                        <label class="form-label fw-medium">
                            <i class="bi bi-tag me-1"></i> Tags (Optional)
                        </label>
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control @(ThemeService.IsDarkMode ? "bg-transparent text-light" : "")"
                                   placeholder="Add custom tag..."
                                   @bind="newTag"
                                   @onkeypress="HandleTagKeyPress" />
                            <button class="btn btn-primary" style="margin-left:20px" @onclick="AddTag">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>

                        @if (selectedTags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var tag in selectedTags)
                                {
                                    <span class="badge bg-primary rounded-pill d-flex align-items-center gap-1 px-3 py-2">
                                        @tag
                                        <i class="bi bi-x" @onclick="() => RemoveTag(tag)" style="cursor: pointer;"></i>
                                    </span>
                                }
                            </div>
                        }

                        <div>
                            <label class="form-label small text-muted">Preset Tags:</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in presetTags)
                                {
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill"
                                            @onclick="() => AddPresetTag(tag)">
                                        @tag
                                    </button>
                                }
                            </div>
                            <button class="btn btn-link btn-sm text-primary text-decoration-none p-0 mt-2"
                                    @onclick="ShowAllTags">
                                Show All (31 tags)
                            </button>
                        </div>
                    </div>

                    <!-- Save Button -->
                    <div class="d-flex justify-content-end mb-4">
                        <button class="btn btn-primary px-4" @onclick="SaveEntry">
                            <i class="bi bi-save me-2"></i> Save Entry
                        </button>
                    </div>

                    <!-- Lock Entry Section -->
                    <div class="border-top pt-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-lock"></i>
                                    <span class="fw-medium">Lock Entry with Password</span>
                                </div>
                                <p class="text-muted small mb-0">
                                    Protect this entry with a password to prevent unauthorized edits.
                                </p>
                                <small class="text-muted">
                                    ⓘ Set an entry-first to enable password protection
                                </small>
                            </div>
                            <div class="d-flex gap-2">
                                <input type="password"
                                       class="form-control form-control-sm @(ThemeService.IsDarkMode ? "bg-dark border-secondary" : "")"
                                       placeholder="Set password"
                                       style="width: 150px;"
                                       @bind="entryPassword" />
                                <button class="btn btn-outline-secondary btn-sm" @onclick="LockEntry">
                                    Lock Entry
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string entryTitle = "";
    private string entryContent = "";
    private TimeSpan? entryTime = TimeSpan.FromHours(DateTime.Now.Hour);
    private string selectedMood = "";
    private string newTag = "";
    private string entryPassword = "";
    private List<string> selectedTags = new List<string>();

    
    private List<string> positiveMoods = new() { "Happy", "Excited", "Relaxed", "Grateful", "Confident" };
    private List<string> neutralMoods = new() { "Calm", "Thoughtful", "Curious", "Nostalgic", "Bored" };
    private List<string> negativeMoods = new() { "Sad", "Angry", "Stressed", "Lonely", "Anxious" };

    private List<string> presetTags = new()
    {
        "Work", "Career", "Studies", "Family", "Friends", "Relationships",
        "Health", "Fitness", "Self-care", "Hobbies", "Travel", "Personal Growth"
    };

    private bool isDarkMode => ThemeService.IsDarkMode;
    private string currentModeClass => isDarkMode ? "dark-mode" : "light-mode";

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private void SelectMood(string mood) => selectedMood = mood;

    private void AddTag()
    {
        if (!string.IsNullOrWhiteSpace(newTag) && !selectedTags.Contains(newTag))
        {
            selectedTags.Add(newTag);
            newTag = "";
        }
    }

    private void AddPresetTag(string tag)
    {
        if (!selectedTags.Contains(tag)) selectedTags.Add(tag);
    }

    private void RemoveTag(string tag) => selectedTags.Remove(tag);

    private void HandleTagKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTag();
    }

    private void ShowAllTags()
    {
        // Show all tags modal or expand
    }

    private async Task SaveEntry()
    {
        
        if (string.IsNullOrEmpty(entryTitle))
        {
            Console.WriteLine("Title should not be null");
            throw new InvalidDataException();
        }
        

        Journal journal = new Journal()
        {
            JournalId = Guid.NewGuid(),
            Title = entryTitle,
            Description = entryContent,
            TagId= Guid.Parse("4FA85F64-5717-4562-B3FC-2C963F66AF20"),
            MoodId = Guid.Parse("3FA85F64-5717-4562-B3FC-2C963F66AF10"),
            CreatedAt = DateTime.Now
        };
        await _journalService.AddJournalAsync(journal);
        nav.NavigateTo("/");
       
    }

    private void LockEntry()
    {
        // Lock entry logic
    }
}
