@page "/home"
@page "/home/{JournalId:guid}"
@using Microsoft.AspNetCore.Components.Web
@using Mitra_Journal.Components.Layout
@using Mitra_Journal.Entities
@using Mitra_Journal.Services
@using Mitra_Journal.Services.Interface
@inject IJournalService _journalService
@inject NavigationManager nav
@inject ITagsService tagsService
@inject IMoodService moodService
@inject ThemeService ThemeService
@implements IDisposable
@layout MainLayout
@inject IJSRuntime JS

<div class="min-h-screen @(isDarkMode ? "bg-gray-900" : "bg-gray-50") p-6">
    <div class="flex-fill mx-auto">

        <div class="flex justify-between items-start mb-8">
            <div class="flex items-center gap-4">
                <div class="bg-indigo-600 rounded-2xl flex items-center justify-center w-16 h-16">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold @(isDarkMode ? "text-gray-100" : "text-gray-900")">
                        @(IsEditMode ? "Edit Journal Entry" : "Daily Journal")
                    </h1>
                    <p class="@(isDarkMode ? "text-gray-400" : "text-gray-600") text-sm mt-1">
                        @(IsEditMode ? "Update your journal entry" : "Capture your thoughts, track your moods")
                    </p>
                </div>
            </div>
            
            <div class="@(isDarkMode ? "bg-gray-800 border-gray-700" : "bg-orange-50 border-orange-100") rounded-2xl shadow-sm border px-6 py-4">
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6 text-orange-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
                    </svg>
                    <div>
                        <div class="text-sm @(isDarkMode ? "text-gray-400" : "text-orange-600") font-medium">Current Streak</div>
                        <div class="text-2xl font-bold @(isDarkMode ? "text-gray-100" : "text-orange-600")">
                            @currentStreak <span class="text-sm font-normal">days</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (hasEntryToday && !IsEditMode)
        {
            <div class="@(isDarkMode ? "bg-blue-900/20 border-blue-800 text-blue-300" : "bg-blue-50 border-blue-200 text-blue-800") border rounded-xl p-6 flex items-start gap-3 mb-6">
                <svg class="w-6 h-6 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <div class="flex-1">
                    <h3 class="font-semibold text-lg mb-2">You've already created an entry today!</h3>
                    <p class="mb-4">You can only create one journal entry per day. You can edit today's entry or view all your entries.</p>
                    <div class="flex gap-3">
                        <button type="button"
                                class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium transition-all"
                                @onclick="EditTodayEntry">
                            Edit Today's Entry
                        </button>
                        <button type="button"
                                class="px-4 py-2 @(isDarkMode ? "bg-gray-700 hover:bg-gray-600 text-gray-200" : "bg-white hover:bg-gray-100 text-gray-700 border border-gray-300") rounded-lg font-medium transition-all"
                                @onclick="ViewAllEntries">
                            View All Entries
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (!CanEdit && IsEditMode)
        {
            <div class="@(isDarkMode ? "bg-yellow-900/20 border-yellow-800 text-yellow-300" : "bg-yellow-50 border-yellow-200 text-yellow-800") border rounded-xl p-4 flex items-start gap-3 mb-6">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <div>
                    You can only edit journal entries created today. This entry was created on @journalCreatedDate.ToString("MMMM dd, yyyy").
                </div>
            </div>
        }

        @if (!hasEntryToday || IsEditMode)
        {
            <div class="@(isDarkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-100")  rounded-3xl shadow-lg border p-8">

                <div class="flex items-center gap-2 mb-6">
                    <svg class="w-5 h-5 @(isDarkMode ? "text-gray-400" : "text-gray-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span class="@(isDarkMode ? "text-gray-400" : "text-gray-600")">
                        @(IsEditMode ? journalCreatedDate.ToString("dddd, MMMM dd, yyyy") : DateTime.Now.ToString("dddd, MMMM dd, yyyy"))
                    </span>
                </div>

                <div class="mb-8">
                    <label class="block text-base font-semibold @(isDarkMode ? "text-gray-100" : "text-gray-900") mb-4">
                        How are you feeling today? <span class="text-red-500">*</span>
                    </label>

                    <div class="mb-4">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="rounded-full bg-green-500 flex items-center justify-center w-6 h-6">
                                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-.464 5.535a1 1 0 10-1.415-1.414 3 3 0 01-4.242 0 1 1 0 00-1.415 1.414 5 5 0 007.072 0z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <span class="text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700")">Positive</span>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var mood in positiveMoods)
                            {
                                <button type="button"
                                        class="@GetMoodButtonClass(mood.MoodName) px-6 py-3 rounded-full text-base font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="() => ToggleMood(mood.MoodName)"
                                        disabled="@(!CanEdit)">
                                    @if (primaryMood == mood.MoodName)
                                    {
                                        <svg class="w-3 h-3 inline-block mr-1 -mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    }
                                    else if (secondaryMoods.Contains(mood.MoodName))
                                    {
                                        <svg class="w-3 h-3 inline-block mr-1 -mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
                                        </svg>
                                    }
                                    @mood.MoodName
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="rounded-full bg-blue-500 flex items-center justify-center w-6 h-6">
                                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-7 4a1 1 0 011-1h4a1 1 0 110 2H8a1 1 0 01-1-1z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <span class="text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700")">Neutral</span>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var mood in neutralMoods)
                            {
                                <button type="button"
                                        class="@GetMoodButtonClass(mood.MoodName) px-6 py-3 rounded-full text-base font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="() => ToggleMood(mood.MoodName)"
                                        disabled="@(!CanEdit)">
                                    @if (primaryMood == mood.MoodName)
                                    {
                                        <svg class="w-3 h-3 inline-block mr-1 -mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    }
                                    else if (secondaryMoods.Contains(mood.MoodName))
                                    {
                                        <svg class="w-3 h-3 inline-block mr-1 -mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
                                        </svg>
                                    }
                                    @mood.MoodName
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="rounded-full bg-red-500 flex items-center justify-center w-6 h-6">
                                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-3.536 5.879a1 1 0 001.414 0 5 5 0 00-7.071 0 1 1 0 101.414 1.414 3 3 0 004.243 0z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <span class="text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700")">Negative</span>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var mood in negativeMoods)
                            {
                                <button type="button"
                                        class="@GetMoodButtonClass(mood.MoodName) px-6 py-3 rounded-full text-base font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="() => ToggleMood(mood.MoodName)"
                                        disabled="@(!CanEdit)">
                                    @if (primaryMood == mood.MoodName)
                                    {
                                        <svg class="w-3 h-3 inline-block mr-1 -mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    }
                                    else if (secondaryMoods.Contains(mood.MoodName))
                                    {
                                        <svg class="w-3 h-3 inline-block mr-1 -mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
                                        </svg>
                                    }
                                    @mood.MoodName
                                </button>
                            }
                        </div>
                    </div>

                    <p class="text-xs @(isDarkMode ? "text-gray-400" : "text-gray-500") mt-3">
                        Click a mood to set as primary. Use the + button to add up to 2 secondary moods. Click again to remove.
                    </p>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">
                        Title (Optional)
                    </label>
                    <input type="text"
                           class="w-full px-4 py-3 rounded-xl border @(isDarkMode ? "bg-gray-900 border-gray-700 text-gray-100 placeholder-gray-500" : "bg-gray-50 border-gray-200 text-gray-900 placeholder-gray-400") focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
                           placeholder="Give your entry a title..."
                           @bind="entryTitle"
                           disabled="@(!CanEdit)" />
                </div>

                <div class="mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700")">
                            <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Journal Entry
                        </label>
                    </div>
                    <div id="editor"
                         class="min-h-[300px] px-4 py-3 rounded-xl border @(isDarkMode ? "bg-gray-900 border-gray-700 text-gray-100" : "bg-white border-gray-200 text-gray-900") focus-within:ring-2 focus-within:ring-indigo-500 transition">
                    </div>
                    <p class="text-xs @(isDarkMode ? "text-gray-400" : "text-gray-500") mt-2">
                        Markdown supported: # Headers, **bold**, *italic*, [link](url), lists
                    </p>
                </div>

                <div class="mb-8">
                    <label class="block text-sm font-medium @(isDarkMode ? "text-gray-300" : "text-gray-700") mb-2">
                        <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                        </svg>
                        Tags (Optional)
                    </label>
                    <div class="flex gap-2 mb-3">
                        <input type="text"
                               class="flex-1 px-4 py-2.5 rounded-xl border @(isDarkMode ? "bg-gray-900 border-gray-700 text-gray-100 placeholder-gray-500" : "bg-gray-50 border-gray-200 text-gray-900 placeholder-gray-400") focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
                               placeholder="Add custom tag..."
                               @bind="newTag"
                               @onkeypress="HandleTagKeyPress"
                               disabled="@(!CanEdit)" />
                        <button type="button"
                                class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                @onclick="AddTag"
                                disabled="@(!CanEdit)">
                            + Add
                        </button>
                    </div>

                    @if (selectedTags.Count > 0)
                    {
                        <div class="flex flex-wrap gap-2 mb-4">
                            @foreach (var tag in selectedTags)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 @(isDarkMode ? "bg-indigo-900/30 text-indigo-300" : "bg-indigo-100 text-indigo-700") rounded-full text-sm font-medium">
                                    @tag
                                    @if (CanEdit)
                                    {
                                        <button type="button" @onclick="() => RemoveTag(tag)" class="hover:bg-indigo-200/50 rounded-full p-0.5">
                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                    }
                                </span>
                            }
                        </div>
                    }

                    <div>
                        <p class="text-xs @(isDarkMode ? "text-gray-400" : "text-gray-600") mb-2 font-medium">Prebuilt Tags:</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var tag in (showAllPresetTags ? presetTags : presetTags.Take(9)))
                            {
                                <button type="button"
                                        class="px-3 py-1.5 @(isDarkMode ? "bg-gray-700 hover:bg-gray-600 text-gray-300" : "bg-gray-100 hover:bg-gray-200 text-gray-700") rounded-full text-sm font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="() => AddPresetTag(tag.TagName)"
                                        disabled="@(!CanEdit)">
                                    @tag.TagName
                                </button>
                            }
                        </div>
                        @if (presetTags.Count > 9)
                        {
                            <button type="button" 
                                    class="text-indigo-600 hover:text-indigo-700 text-sm font-medium mt-2 inline-flex items-center gap-1" 
                                    @onclick="ShowAllTags">
                                @if (showAllPresetTags)
                                {
                                    <span>Show Less</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                    </svg>
                                }
                                else
                                {
                                    <span>Show All (@presetTags.Count tags)</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                }
                            </button>
                        }
                    </div>
                </div>

                <div class="flex justify-end gap-3">
                    @if (IsEditMode)
                    {
                        <button type="button"
                                class="px-6 py-3 @(isDarkMode ? "bg-gray-700 hover:bg-gray-600 text-gray-200" : "bg-gray-100 hover:bg-gray-200 text-gray-700") rounded-xl font-semibold transition-all"
                                @onclick="CancelEdit">
                            Cancel
                        </button>
                    }

                    @if (CanEdit)
                    {
                        <button type="button"
                                class="px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all flex items-center gap-2"
                                @onclick="SaveEntry">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                            </svg>
                            @(IsEditMode ? "Update Entry" : "Save Entry")
                        </button>
                    }
                </div>

            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid? JournalId { get; set; }

    private bool IsEditMode => JournalId.HasValue;
    private bool CanEdit => !IsEditMode || (IsEditMode && journalCreatedDate.Date == DateTime.Now.Date);
    private DateTime journalCreatedDate = DateTime.Now;

    private string HtmlContent = "";
    private string entryTitle = "";
    private string entryContent = "";
    private TimeSpan? entryTime = TimeSpan.FromHours(DateTime.Now.Hour);
    private string primaryMood = "";
    private List<string> secondaryMoods = new List<string>();
    private string newTag = "";
    private string entryPassword = "";
    private string moodId = "";
    private string tagId = "";
    private List<string> selectedTags = new List<string>();
    private int currentStreak = 0;
    private List<Mood> positiveMoods = new List<Mood>();
    private List<Mood> neutralMoods = new List<Mood>();
    private List<Mood> negativeMoods = new List<Mood>();

    private List<Tags> presetTags = new List<Tags>();
    private bool showAllPresetTags = false;

    private bool hasEntryToday = false;
    private Guid? todayEntryId = null;

    private bool isDarkMode => ThemeService.IsDarkMode;

    protected async override Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        LoadTags();
        LoadMoods();
        await GetStreaks();

        if (IsEditMode && JournalId.HasValue)
        {
            await LoadJournalForEdit(JournalId.Value);
        }
        
        await CheckTodayEntry();
    }

    private async Task CheckTodayEntry()
    {
        if (IsEditMode && journalCreatedDate.Date == DateTime.Now.Date)
        {
            hasEntryToday = false;
            todayEntryId = JournalId;
            return;
        }

        var (count, journals) = await _journalService.GetAllJournalsAsync(1, int.MaxValue);
        var todayEntry = journals.FirstOrDefault(j => j.CreatedAt.Date == DateTime.Now.Date);
        
        if (todayEntry != null)
        {
            hasEntryToday = true;
            todayEntryId = todayEntry.JournalId;
        }
        else
        {
            hasEntryToday = false;
            todayEntryId = null;
        }
    }

    private void EditTodayEntry()
    {
        if (todayEntryId.HasValue)
        {
            nav.NavigateTo($"/home/{todayEntryId.Value}", forceLoad: true);
        }
    }

    private void ViewAllEntries()
    {
        nav.NavigateTo("/all-entries");
    }

    private async Task LoadJournalForEdit(Guid journalId)
    {
        var journal = await _journalService.GetJournalByIdAsync(journalId);
        
        if (journal != null)
        {
            journalCreatedDate = journal.CreatedAt;
            entryTitle = journal.Title;
            entryContent = journal.Description;

            var allMoods = positiveMoods.Concat(neutralMoods).Concat(negativeMoods).ToList();
            var primaryMoodObj = allMoods.FirstOrDefault(m => m.MoodId == journal.MoodId);
            if (primaryMoodObj != null)
            {
                primaryMood = primaryMoodObj.MoodName;
            }

            secondaryMoods.Clear();
            if (journal.SecondaryMoodId1 != null)
            {
                var secondaryMood1 = allMoods.FirstOrDefault(m => m.MoodId == journal.SecondaryMoodId1);
                if (secondaryMood1 != null)
                {
                    secondaryMoods.Add(secondaryMood1.MoodName);
                }
            }

            if (journal.SecondaryMoodId2 != null)
            {
                var secondaryMood2 = allMoods.FirstOrDefault(m => m.MoodId == journal.SecondaryMoodId2);
                if (secondaryMood2 != null)
                {
                    secondaryMoods.Add(secondaryMood2.MoodName);
                }
            }

            selectedTags.Clear();
            foreach (var jt in journal.JournalTags)
            {
                selectedTags.Add(jt.Tag.TagName);
            }
        }
    }
    
    private async Task GetStreaks()
    {
        var streak = await _journalService.GetStreaksAsync();
        currentStreak = streak.CurrentStreak;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!hasEntryToday || IsEditMode)
        {
            await JS.InvokeVoidAsync("initQuill", "editor");
            await Task.Delay(100);

            if (!string.IsNullOrEmpty(entryContent))
            {
                await JS.InvokeVoidAsync("setQuillHtml", entryContent);
            }

            if (!CanEdit)
            {
                try
                {
                    await JS.InvokeVoidAsync("eval", "if(window.quill){ window.quill.enable(false); }");
                }
                catch
                {
                }
            }
        }
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private void ToggleMood(string mood)
    {
        if (!CanEdit) return;

        if (primaryMood == mood)
        {
            primaryMood = "";
            return;
        }

        if (secondaryMoods.Contains(mood))
        {
            secondaryMoods.Remove(mood);
            return;
        }

        if (string.IsNullOrEmpty(primaryMood))
        {
            primaryMood = mood;
            return;
        }

        if (secondaryMoods.Count < 2)
        {
            secondaryMoods.Add(mood);
        }
    }

    private string GetMoodButtonClass(string mood)
    {
        if (primaryMood == mood)
        {
            return isDarkMode 
                ? "bg-indigo-600 text-white border-2 border-indigo-500" 
                : "bg-indigo-600 text-white border-2 border-indigo-600";
        }
        else if (secondaryMoods.Contains(mood))
        {
            return isDarkMode 
                ? "bg-green-900/30 text-green-300 border-2 border-green-700" 
                : "bg-green-100 text-green-700 border-2 border-green-400";
        }
        else
        {
            return isDarkMode 
                ? "bg-transparent text-gray-300 border-2 border-gray-600 hover:bg-gray-800" 
                : "bg-white text-gray-700 border-2 border-gray-300 hover:bg-gray-50";
        }
    }

    private void LoadTags()
    {
        var loadedTags = tagsService.GetTags();
        presetTags.AddRange(loadedTags);
    }

    private void LoadMoods()
    {
        var loadedMoods = moodService.GetAllMoods();
        positiveMoods.AddRange(loadedMoods.Where(x=>x.MoodCategory == "Positive"));
        negativeMoods.AddRange(loadedMoods.Where(x=>x.MoodCategory == "Negative"));
        neutralMoods.AddRange(loadedMoods.Where(x=>x.MoodCategory == "Neutral"));
    }

    private void AddTag()
    {
        if (!CanEdit) return;

        if (!string.IsNullOrWhiteSpace(newTag) && !selectedTags.Contains(newTag))
        {
            selectedTags.Add(newTag);
            newTag = "";
        }
    }

    private void AddPresetTag(string tag)
    {
        if (!CanEdit) return;
        if (!selectedTags.Contains(tag)) selectedTags.Add(tag);
    }

    private void RemoveTag(string tag)
    {
        if (!CanEdit) return;
        selectedTags.Remove(tag);
    }

    private void HandleTagKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTag();
    }

    private void ShowAllTags()
    {
        showAllPresetTags = !showAllPresetTags;
    }

