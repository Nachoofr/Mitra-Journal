@page "/home"
@page "/home/{JournalId:guid}"
@using Microsoft.AspNetCore.Components.Web
@using Mitra_Journal.Components.Layout
@using Mitra_Journal.Entities
@using Mitra_Journal.Services
@using Mitra_Journal.Services.Interface
@inject IJournalService _journalService
@inject NavigationManager nav
@inject ITagsService tagsService
@inject IMoodService moodService
@inject ThemeService ThemeService
@implements IDisposable
@layout MainLayout
@inject IJSRuntime JS

<div class="d-flex vh-100 w-100 @(currentModeClass)">

    <div class="flex-fill p-4 overflow-auto @(ThemeService.IsDarkMode ? "dark-mode" : "light-mode")">
        <div class="container-fluid" >

            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-journal-text text-white fs-3"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold mb-1 @(ThemeService.IsDarkMode ? "text-light" : "")">
                            @(IsEditMode ? "Edit Journal Entry" : "Daily Journal")
                        </h2>
                        <p class="mb-0 @(ThemeService.IsDarkMode ? "text-secondary" : "text-muted")">
                            @(IsEditMode ? "Update your journal entry" : "Capture your thoughts, track your moods")
                        </p>
                    </div>
                </div>
                <div class="card shadow-sm @(ThemeService.IsDarkMode ? "bg-dark border-secondary" : "")">
                    <div class="card-body p-3 d-flex align-items-center gap-2">
                        <i class="bi bi-fire text-warning fs-5"></i>
                        <div>
                            <div class="fw-bold @(ThemeService.IsDarkMode ? "text-light" : "")">Current Streak</div>
                            <div class="small @(ThemeService.IsDarkMode ? "text-secondary" : "text-muted")">
                                <span class="fw-bold @(ThemeService.IsDarkMode ? "text-light" : "")">@currentStreak</span> days
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!CanEdit && IsEditMode)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>
                        You can only edit journal entries created today. This entry was created on @journalCreatedDate.ToString("MMMM dd, yyyy").
                    </div>
                </div>
            }

            <div class="card shadow-sm @(ThemeService.IsDarkMode ? "bg-dark border-secondary" : "")">
                <div class="card-body p-4">

         
                    <div class="d-flex align-items-center gap-2 text-muted mb-4">
                        <i class="bi bi-calendar3"></i>
                        <span>@(IsEditMode ? journalCreatedDate.ToString("dddd, MMMM dd, yyyy") : DateTime.Now.ToString("dddd, MMMM dd, yyyy"))</span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Time (Optional)</label>
                        <input type="time" 
                               class="form-control @(ThemeService.IsDarkMode ? "bg-transparent text-light" : "")" 
                               disabled="@(!CanEdit)" />
                    </div>

          
                    <div class="mb-4">
                        <label class="form-label fw-semibold mb-3">
                            How are you feeling today? <span class="text-danger">*</span>
                        </label>


                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                    <i class="bi bi-emoji-smile text-white" style="font-size: 14px;"></i>
                                </div>
                                <span class="small fw-medium">Positive</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mood in positiveMoods)
                                {
                                    <input type="hidden" @bind="@mood.MoodId">
                                    <button class="btn btn-sm rounded-pill @GetMoodButtonClass(mood.MoodName)"
                                            @onclick="() => ToggleMood(mood.MoodName)"
                                            disabled="@(!CanEdit)">
                                        @if (primaryMood == mood.MoodName)
                                        {
                                            <i class="bi bi-star-fill me-1"></i>
                                        }
                                        else if (secondaryMoods.Contains(mood.MoodName))
                                        {
                                            <i class="bi bi-plus-circle-fill me-1"></i>
                                        }
                                        @mood.MoodName
                                    </button>
                                }
                            </div>
                        </div>


                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-info d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                    <i class="bi bi-emoji-neutral text-white" style="font-size: 14px;"></i>
                                </div>
                                <span class="small fw-medium">Neutral</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mood in neutralMoods)
                                {
                                    <input type="hidden" @bind="@mood.MoodId">
                                    <button class="btn btn-sm rounded-pill @GetMoodButtonClass(mood.MoodName)"
                                            @onclick="() => ToggleMood(mood.MoodName)"
                                            disabled="@(!CanEdit)">
                                        @if (primaryMood == mood.MoodName)
                                        {
                                            <i class="bi bi-star-fill me-1"></i>
                                        }
                                        else if (secondaryMoods.Contains(mood.MoodName))
                                        {
                                            <i class="bi bi-plus-circle-fill me-1"></i>
                                        }
                                        @mood.MoodName
                                    </button>
                                }
                            </div>
                        </div>


                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                    <i class="bi bi-emoji-frown text-white" style="font-size: 14px;"></i>
                                </div>
                                <span class="small fw-medium">Negative</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mood in negativeMoods)
                                {
                                    <input type="hidden" @bind="@mood.MoodId">
                                    <button class="btn btn-sm rounded-pill @GetMoodButtonClass(mood.MoodName)"
                                            @onclick="() => ToggleMood(mood.MoodName)"
                                            disabled="@(!CanEdit)">
                                        @if (primaryMood == mood.MoodName)
                                        {
                                            <i class="bi bi-star-fill me-1"></i>
                                        }
                                        else if (secondaryMoods.Contains(mood.MoodName))
                                        {
                                            <i class="bi bi-plus-circle-fill me-1"></i>
                                        }
                                        @mood.MoodName
                                    </button>
                                }
                            </div>
                        </div>

                        <small class="text-muted">
                            <i class="bi bi-star-fill text-warning"></i> Primary mood | 
                            <i class="bi bi-plus-circle-fill text-primary"></i> Secondary moods (up to 2) | 
                            Click again to remove
                        </small>
                    </div>

                    
                    <div class="mb-4">
                        <input type="text"
                               class="form-control form-control-lg border-0 px-0 @(ThemeService.IsDarkMode ? "bg-transparent text-light" : "")"
                               placeholder="Give your entry a title..."
                               @bind="entryTitle"
                               disabled="@(!CanEdit)" />
                    </div>


                    <div id="editor"
                         class="mb-4 min-h-[400px] form-control
                            @(ThemeService.IsDarkMode ? "bg-dark text-light border-secondary" : "")">
                    </div>


                    <div class="mb-4">
                        <label class="form-label fw-medium">
                            <i class="bi bi-tag me-1"></i> Tags (Optional)
                        </label>
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control @(ThemeService.IsDarkMode ? "bg-transparent text-light" : "")"
                                   placeholder="Add custom tag..."
                                   @bind="newTag"
                                   @onkeypress="HandleTagKeyPress"
                                   disabled="@(!CanEdit)" />
                            <button class="btn btn-primary" 
                                    style="margin-left:20px" 
                                    @onclick="AddTag"
                                    disabled="@(!CanEdit)">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>

                        @if (selectedTags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var tag in selectedTags)
                                {
                                    <span class="badge bg-primary rounded-pill d-flex align-items-center gap-1 px-3 py-2">
                                        @tag
                                        @if (CanEdit)
                                        {
                                            <i class="bi bi-x" @onclick="() => RemoveTag(tag)" style="cursor: pointer;"></i>
                                        }
                                    </span>
                                }
                            </div>
                        }

                        <div>
                            <label class="form-label small text-muted">Preset Tags:</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in presetTags)
                                {
                                    <input type="hidden" @bind="@tag.TagId">
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill"
                                            @onclick="() => AddPresetTag(tag.TagName)"
                                            disabled="@(!CanEdit)">
                                        @tag.TagName
                                    </button>
                                }
                            </div>
                            <button class="btn btn-link btn-sm text-primary text-decoration-none p-0 mt-2"
                                    @onclick="ShowAllTags">
                                Show All (31 tags)
                            </button>
                        </div>
                    </div>


                    <div class="d-flex justify-content-between mb-4">
                        @if (IsEditMode)
                        {
                            <button class="btn btn-outline-secondary px-4" @onclick="CancelEdit">
                                <i class="bi bi-x-circle me-2"></i> Cancel
                            </button>
                        }
                        else
                        {
                            <div></div>
                        }
                        
                        @if (CanEdit)
                        {
                            <button class="btn btn-primary px-4" @onclick="SaveEntry">
                                <i class="bi bi-save me-2"></i> @(IsEditMode ? "Update Entry" : "Save Entry")
                            </button>
                        }
                    </div>
                    

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid? JournalId { get; set; }

    private bool IsEditMode => JournalId.HasValue;
    private bool CanEdit => !IsEditMode || (IsEditMode && journalCreatedDate.Date == DateTime.Now.Date);
    private DateTime journalCreatedDate = DateTime.Now;

    private string HtmlContent = "";
    private string entryTitle = "";
    private string entryContent = "";
    private TimeSpan? entryTime = TimeSpan.FromHours(DateTime.Now.Hour);
    private string primaryMood = "";
    private List<string> secondaryMoods = new List<string>();
    private string newTag = "";
    private string entryPassword = "";
    private string moodId = "";
    private string tagId = "";
    private List<string> selectedTags = new List<string>();
    private int currentStreak = 0;
    private List<Mood> positiveMoods = new List<Mood>();
    private List<Mood> neutralMoods = new List<Mood>();
    private List<Mood> negativeMoods = new List<Mood>();

    private List<Tags> presetTags = new List<Tags>();

    private bool isDarkMode => ThemeService.IsDarkMode;
    private string currentModeClass => isDarkMode ? "dark-mode" : "light-mode";

    protected async override Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        LoadTags();
        LoadMoods();
        await GetStreaks();

        // Load journal if editing
        if (IsEditMode && JournalId.HasValue)
        {
            await LoadJournalForEdit(JournalId.Value);
        }
    }

    private async Task LoadJournalForEdit(Guid journalId)
    {
        var journal = await _journalService.GetJournalByIdAsync(journalId);
        
        if (journal != null)
        {
            journalCreatedDate = journal.CreatedAt;
            entryTitle = journal.Title;
            entryContent = journal.Description;

            // Load primary mood
            var allMoods = positiveMoods.Concat(neutralMoods).Concat(negativeMoods).ToList();
            var primaryMoodObj = allMoods.FirstOrDefault(m => m.MoodId == journal.MoodId);
            if (primaryMoodObj != null)
            {
                primaryMood = primaryMoodObj.MoodName;
            }

            // Load secondary moods
            secondaryMoods.Clear();
            if (journal.SecondaryMoodId1 != null)
            {
                var secondaryMood1 = allMoods.FirstOrDefault(m => m.MoodId == journal.SecondaryMoodId1);
                if (secondaryMood1 != null)
                {
                    secondaryMoods.Add(secondaryMood1.MoodName);
                }
            }

            if (journal.SecondaryMoodId2 != null)
            {
                var secondaryMood2 = allMoods.FirstOrDefault(m => m.MoodId == journal.SecondaryMoodId2);
                if (secondaryMood2 != null)
                {
                    secondaryMoods.Add(secondaryMood2.MoodName);
                }
            }

            // Load tags
            selectedTags.Clear();
            foreach (var jt in journal.JournalTags)
            {
                selectedTags.Add(jt.Tag.TagName);
            }
        }
    }
    
    private async Task GetStreaks()
    {
        var streak = await _journalService.GetStreaksAsync();
        currentStreak = streak.CurrentStreak;
       
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Initialize Quill editor
        await JS.InvokeVoidAsync("initQuill", "editor");

        // Load content into Quill if editing or viewing past entries
        if (!string.IsNullOrEmpty(entryContent))
        {
            await JS.InvokeVoidAsync("setQuillHtml", entryContent);
        }

        // If the user cannot edit (past entry), disable the editor safely
        if (!CanEdit)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", "if(window.quill){ window.quill.enable(false); }");
            }
            catch
            {
                // Ignore JS errors for past entries
            }
        }
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private void ToggleMood(string mood)
    {
        if (!CanEdit) return;

        // If clicking the primary mood, remove it
        if (primaryMood == mood)
        {
            primaryMood = "";
            return;
        }

        // If clicking a secondary mood, remove it
        if (secondaryMoods.Contains(mood))
        {
            secondaryMoods.Remove(mood);
            return;
        }

        // If no primary mood is set, set it as primary
        if (string.IsNullOrEmpty(primaryMood))
        {
            primaryMood = mood;
            return;
        }

        // If we have less than 2 secondary moods, add it as secondary
        if (secondaryMoods.Count < 2)
        {
            secondaryMoods.Add(mood);
        }
    }

    private string GetMoodButtonClass(string mood)
    {
        if (primaryMood == mood)
        {
            return "btn-primary"; // Primary mood - filled button
        }
        else if (secondaryMoods.Contains(mood))
        {
            return "btn-success"; // Secondary mood - success button
        }
        else
        {
            return "btn-outline-secondary"; // Unselected - outline button
        }
    }

    private void LoadTags()
    {
        var loadedTags = tagsService.GetTags();
        presetTags.AddRange(loadedTags);
    }

    private void LoadMoods()
    {
        var loadedMoods =  moodService.GetAllMoods();
        positiveMoods.AddRange(loadedMoods.Where(x=>x.MoodCategory == "Positive"));
        negativeMoods.AddRange(loadedMoods.Where(x=>x.MoodCategory == "Negative"));
        neutralMoods.AddRange(loadedMoods.Where(x=>x.MoodCategory == "Neutral"));
    }

    private void AddTag()
    {
        if (!CanEdit) return;

        if (!string.IsNullOrWhiteSpace(newTag) && !selectedTags.Contains(newTag))
        {
            selectedTags.Add(newTag);
            newTag = "";
        }
    }

    private void AddPresetTag(string tag)
    {
        if (!CanEdit) return;
        if (!selectedTags.Contains(tag)) selectedTags.Add(tag);
    }

    private void RemoveTag(string tag)
    {
        if (!CanEdit) return;
        selectedTags.Remove(tag);
    }

    private void HandleTagKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTag();
    }

    private void ShowAllTags()
    {
    }

    private void CancelEdit()
    {
        nav.NavigateTo("/all-entries");
    }

    private async Task SaveEntry()
    {
        if (!CanEdit)
        {
            return;
        }

        // 1️⃣ Get all moods
        var allMoods = positiveMoods.Concat(neutralMoods).Concat(negativeMoods).ToList();

        // Get primary mood
        var mood = allMoods.FirstOrDefault(m => m.MoodName == primaryMood);
        if (mood == null)
        {
            Console.WriteLine("No primary mood selected!");
            return;
        }

        // Get secondary moods
        Guid? secondaryMoodId1 = null;
        Guid? secondaryMoodId2 = null;

        if (secondaryMoods.Count > 0)
        {
            var secondaryMood1 = allMoods.FirstOrDefault(m => m.MoodName == secondaryMoods[0]);
            if (secondaryMood1 != null)
            {
                secondaryMoodId1 = secondaryMood1.MoodId;
            }
        }

        if (secondaryMoods.Count > 1)
        {
            var secondaryMood2 = allMoods.FirstOrDefault(m => m.MoodName == secondaryMoods[1]);
            if (secondaryMood2 != null)
            {
                secondaryMoodId2 = secondaryMood2.MoodId;
            }
        }

        // 2️⃣ Validate title
        if (string.IsNullOrWhiteSpace(entryTitle))
        {
            Console.WriteLine("Title should not be null");
            return;
        }

        // 3️⃣ Get content from Quill editor
        entryContent = await JS.InvokeAsync<string>("getQuillHtml");

        // 4️⃣ Prepare Journal object
        var journal = new Journal
        {
            JournalId = IsEditMode ? JournalId.Value : Guid.NewGuid(),
            Title = entryTitle,
            Description = entryContent,
            MoodId = mood.MoodId,
            SecondaryMoodId1 = secondaryMoodId1.Value,
            SecondaryMoodId2 = secondaryMoodId2.Value,
            CreatedAt = IsEditMode ? journalCreatedDate : DateTime.Now,
            JournalTags = new List<JournalTags>()
        };

        // 5️⃣ Process all selected tags
        foreach (var tagName in selectedTags)
        {
            // Check if tag already exists
            var tag = presetTags.FirstOrDefault(t => t.TagName.Equals(tagName, StringComparison.OrdinalIgnoreCase));

            // If tag doesn't exist, create it
            if (tag == null)
            {
                tag = tagsService.AddTag(tagName);
                presetTags.Add(tag); // Add to preset list
            }

            // Create JournalTags link
            var journalTag = new JournalTags
            {
                JournalId = journal.JournalId,
                TagId = tag.TagId,
                Tag = tag
            };

            journal.JournalTags.Add(journalTag);
        }

        // 6️⃣ Save or update journal
        if (IsEditMode)
        {
            await _journalService.UpdateJournalAsync(journal);
        }
        else
        {
            await _journalService.AddJournalAsync(journal);
        }

        nav.NavigateTo("/all-entries");
    }

    private void LockEntry()
    {
    }
}