@using Microsoft.AspNetCore.Components.Routing
@using Mitra_Journal.Services
@inject NavigationManager nav
@inject ThemeService ThemeService
@implements IDisposable

<nav class="nav flex-column gap-1">
    <!-- Home -->
    <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded"
             href="/home"
             Match="NavLinkMatch.Prefix"
             ActiveClass="@(ThemeService.IsDarkMode ? "text-light bg-opacity-10 bg-primary fw-medium" : "text-primary bg-primary bg-opacity-10 fw-medium")"
             InactiveClass="@(ThemeService.IsDarkMode ? "text-light" : "text-secondary")">
        <i class="bi bi-house-door"></i>
        <span>Home</span>
    </NavLink>
    
    <!-- All Entries -->
    <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded"
             href="/"
             Match="NavLinkMatch.All"
             ActiveClass="@(ThemeService.IsDarkMode ? "text-light bg-opacity-10 bg-primary fw-medium" : "text-primary bg-primary bg-opacity-10 fw-medium")"
             InactiveClass="@(ThemeService.IsDarkMode ? "text-light" : "text-secondary")">
        <i class="bi bi-list-ul"></i>
        <span>All Entries</span>
    </NavLink>

    <!-- Dashboard -->
    <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded"
             href="/dashboard"
             Match="NavLinkMatch.Prefix"
             ActiveClass="@(ThemeService.IsDarkMode ? "text-light bg-opacity-10 bg-primary fw-medium" : "text-primary bg-primary bg-opacity-10 fw-medium")"
             InactiveClass="@(ThemeService.IsDarkMode ? "text-light" : "text-secondary")">
        <i class="bi bi-bar-chart"></i>
        <span>Dashboard</span>
    </NavLink>

    <!-- Calendar -->
    <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded"
             href="/calendar"
             Match="NavLinkMatch.Prefix"
             ActiveClass="@(ThemeService.IsDarkMode ? "text-light bg-opacity-10 bg-primary fw-medium" : "text-primary bg-primary bg-opacity-10 fw-medium")"
             InactiveClass="@(ThemeService.IsDarkMode ? "text-light" : "text-secondary")">
        <i class="bi bi-calendar3"></i>
        <span>Calendar</span>
    </NavLink>
</nav>

@code {
    [Parameter]
    public bool IsDarkMode { get; set; }
    
    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }
}