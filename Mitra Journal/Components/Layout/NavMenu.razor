@using Microsoft.AspNetCore.Components.Routing
@using Mitra_Journal.Services
@inject NavigationManager nav
@inject ThemeService ThemeService
@implements IDisposable

<style>
    nav a {
        text-decoration: none !important;
    }

    nav a:hover {
        text-decoration: none !important;
    }
</style>

<nav class="flex flex-col gap-1 w-full p-2">
    <!-- Home -->
    <NavLink
        href="/home"
        Match="NavLinkMatch.Prefix"
        class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 no-underline"
        ActiveClass="@(ThemeService.IsDarkMode
        ? "text-indigo-400 bg-indigo-500/10 font-medium"
        : "text-indigo-600 bg-indigo-50 font-medium")"
        InactiveClass="@(ThemeService.IsDarkMode
        ? "text-gray-400 hover:bg-white/5 hover:text-gray-300"
        : "text-gray-700 hover:bg-gray-50")">
        <i class="bi bi-house-door text-xl"></i>
        <span class="text-base">Home</span>
    </NavLink>

    <!-- All Entries -->
    <NavLink
        href="/"
        Match="NavLinkMatch.All"
        class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 no-underline"
        ActiveClass="@(ThemeService.IsDarkMode
        ? "text-indigo-400 bg-indigo-500/10 font-medium"
        : "text-indigo-600 bg-indigo-50 font-medium")"
        InactiveClass="@(ThemeService.IsDarkMode
        ? "text-gray-400 hover:bg-white/5 hover:text-gray-300"
        : "text-gray-700 hover:bg-gray-50")">
        <i class="bi bi-list-ul text-xl"></i>
        <span class="text-base">All Entries</span>
    </NavLink>

    <!-- Dashboard -->
    <NavLink
        href="/dashboard"
        Match="NavLinkMatch.Prefix"
        class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 no-underline"
        ActiveClass="@(ThemeService.IsDarkMode
        ? "text-indigo-400 bg-indigo-500/10 font-medium"
        : "text-indigo-600 bg-indigo-50 font-medium")"
        InactiveClass="@(ThemeService.IsDarkMode
        ? "text-gray-400 hover:bg-white/5 hover:text-gray-300"
        : "text-gray-700 hover:bg-gray-50")">
        <i class="bi bi-grid-3x3-gap text-xl"></i>
        <span class="text-base">Dashboard</span>
    </NavLink>

    <!-- Calendar -->
    <NavLink
        href="/calendar"
        Match="NavLinkMatch.Prefix"
        class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 no-underline"
        ActiveClass="@(ThemeService.IsDarkMode
        ? "text-indigo-400 bg-indigo-500/10 font-medium"
        : "text-indigo-600 bg-indigo-50 font-medium")"
        InactiveClass="@(ThemeService.IsDarkMode
        ? "text-gray-400 hover:bg-white/5 hover:text-gray-300"
        : "text-gray-700 hover:bg-gray-50")">
        <i class="bi bi-calendar3 text-xl"></i>
        <span class="text-base">Calendar</span>
    </NavLink>

    <!-- Export PDF -->
    <NavLink
        href="/export"
        Match="NavLinkMatch.Prefix"
        class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 no-underline"
        ActiveClass="@(ThemeService.IsDarkMode
        ? "text-indigo-400 bg-indigo-500/10 font-medium"
        : "text-indigo-600 bg-indigo-50 font-medium")"
        InactiveClass="@(ThemeService.IsDarkMode
        ? "text-gray-400 hover:bg-white/5 hover:text-gray-300"
        : "text-gray-700 hover:bg-gray-50")">
        <i class="bi bi-file-earmark-pdf text-xl"></i>
        <span class="text-base">Export PDF</span>
    </NavLink>
</nav>

@code {
[Parameter]
public bool IsDarkMode { get; set; }

protected override void OnInitialized()
{
ThemeService.OnChange += StateHasChanged;
}

public void Dispose()
{
ThemeService.OnChange -= StateHasChanged;
}
}