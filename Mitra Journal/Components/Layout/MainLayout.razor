@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using Mitra_Journal.Services
@inherits LayoutComponentBase
@inject NavigationManager nav
@inject ThemeService ThemeService
@implements IDisposable

<div class="d-flex vh-100" style="@(ThemeService.IsDarkMode ? "background-color:#121212;" : "")">
    <div class="d-flex flex-column border-end" style="width: 260px; @(ThemeService.IsDarkMode ? "background-color:#1e1e1e; color:#f0f0f0;" : "background-color:white; color:black;")">
        <div class="p-4">
            <!-- App Header -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-journal-text text-white fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-semibold">Daily Journal</h5>
                    <small class="text-muted">Your thoughts matter</small>
                </div>
            </div>
            <NavMenu IsDarkMode="@ThemeService.IsDarkMode"/>
        </div>

        <!-- Theme Toggle -->
        <div class="mt-auto p-4 border-top">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi @(ThemeService.IsDarkMode ? "bi-moon" : "bi-sun")"></i>
                    <span class="small">@buttonText</span>
                </div>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" @bind="ThemeService.IsDarkMode" />
                </div>
            </div>
            <div class="text-center text-muted small mt-3">
                Keep writing, keep growing ✨
            </div>
        </div>
    </div>

    <!-- Main content -->
    <div class="flex-fill" style="@(ThemeService.IsDarkMode ? "background-color:#121212; color:#f0f0f0;" : "background-color:#f8f9fa;")">
        @Body
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    // Button text changes dynamically
    private string buttonText => ThemeService.IsDarkMode ? "Dark Mode" : "Light Mode";
}